# Base URL of the Cerebro Admin/Read API (Python FastAPI).
# Leave blank → dashboard uses typed mock data in src/lib/mock-data.ts.
# When the API exists, set e.g.:
#   NEXT_PUBLIC_CEREBRO_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_CEREBRO_API_BASE_URL=

# Public site URL for metadata/OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
